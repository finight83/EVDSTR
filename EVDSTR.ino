#pragma once
// ============================================================================
//  EVDSTR.ino - Enkelvoud split server, STREAMER half
// ============================================================================
//
//  EVDSTR receives one Opus frame per 20 ms over the pin link from EVDCTR and
//  is the only board that touches the network on behalf of audio: it fans the
//  frames out to every registered player node, runs the clock-sync responder,
//  keeps the subscriber and player tables, and owns zones, node statistics and
//  the player-facing HTTP API.
//
//  ============================ Core policy ==================================
//
//  CORE 0 - the wire
//    WiFi / lwIP            system tasks
//    audioLink    pri 6     pin link -> opusQueue (the only pin consumer)
//    udpSend      pri 3     opusQueue -> subscribers, absolute 20 ms schedule
//    AsyncTCP     pri 1     HTTP
//    loop()       pri 1     discovery, deferred NVS flush
//
//  CORE 1 - player management
//    players      pri 3     heartbeat bookkeeping, 30 s time broadcast,
//                           node-stats sweep
//
//  Nothing on core 1 sends audio, and nothing on core 0 parses a player's
//  request beyond what the route needs. That is the whole split: one core for
//  the stream, one core for the fleet.
//
//  ============================ What moved from EnkelvoudServer ==============
//
//  Kept, unchanged in behaviour:
//    - the v2 wire format (12-byte header, magic 0xE1D0, version 2)
//    - the subscriber table, registration/heartbeat, compat negotiation
//    - zones, node perf, /api/node_stats, /api/player/ota_result
//    - the absolute-frame-schedule pacer with stale-backlog handling
//    - the RTT clock-sync responder on :4204 and the 30 s time_sync push
//
//  Removed, because they are now EVDCTR's:
//    - every audio input (I2S, USB, DLNA), the resampler, quiet filters,
//      the Opus encoder, the source-board UART and the dashboard's Audio tab
//
//  Changed:
//    - capture timestamps and the wire sequence are stamped HERE, on this
//      board's clock (the two chips boot independently)
//    - the encoder sample rate arrives per frame in the link header, so a
//      dashboard rate change reaches the players with no control channel
//
//  ============================ Project files ================================
//
//    EVDLink.h        wire contract, byte-identical to EVDCTR's copy
//    EVDSTR.ino       this file: constants, POD structs, forward declarations
//    EVDState.h       every mutable global
//    EVDHelpers.h     locks, escaping, subscriber/player table helpers
//    EVDWiFi.h        STA + AP fallback, mDNS, discovery, /api/state
//    EVDLinkSpi.h     SPI2 slave half of the link
//    EVDUDP.h         audio + ctrl + clock-sync sockets, udpSendTask, pacer
//    EVDAudio.h       audioLinkTask (core 0), playerTask (core 1)
//    EVDPlayers.h     registration, zones, config push, node stats, OTA result
//    EVDRoutes.h      route table
//    EVDOTA.h         self-update (pushed from EVDCTR over WiFi)
//    EVDMain.h        setup() / loop()
//    EVDSTRCTRL.h     dashboard (EVDSTRCTRL_GZ.h generated by gen_gz.py)
//    EVDPacer.h       absolute frame schedule
//    build_opt.h, partitions.csv, gen_gz.py
// ============================================================================
