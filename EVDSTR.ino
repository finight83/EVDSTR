// ---- Versioning ------------------------------------------------------------
#ifndef EVD_FW_VERSION
#define EVD_FW_VERSION "1.0.0.0" // EVDSTR: streaming side of the split server
#endif
#define FW_VERSION EVD_FW_VERSION

// ---- Defaults --------------------------------------------------------------
const char *DEFAULT_WIFI_STA_SSID     = "";
const char *DEFAULT_WIFI_STA_PASSWORD = "";
const char *default_ap_ssid           = "Enkelvoud STR";
const char *default_ap_password       = "";

#define WIFI_CONNECT_TIMEOUT_MS 3000

// ---- Factory reset ---------------------------------------------------------
#define PIN_FACTORY_RESET     21
#define FACTORY_RESET_HOLD_MS 3000

// ---- Audio format ----------------------------------------------------------
// Both values must match EVDCTR: the encoder there creates its frames at
// exactly these sizes, and the link header carries the rate per frame.
#define OPUS_SAMPLE_RATE_48K    48000
#define OPUS_SAMPLE_RATE_24K    24000
#define OPUS_SAMPLE_RATE_DEFAULT OPUS_SAMPLE_RATE_48K
#define OPUS_FRAME_MS           20
#define CHANNELS                2
// The receive cap. A frame larger than this cannot exist on the link
// (EVDCTR's encoder is clamped to 192 kbps for exactly this reason).
#define MAX_OPUS_PACKET_LEN 1024
static_assert(MAX_OPUS_PACKET_LEN == LINK_MAX_PAYLOAD,
              "MAX_OPUS_PACKET_LEN must equal LINK_MAX_PAYLOAD");

// The encoder constants the players are told about. EVDSTR never encodes; it
// mirrors EVDCTR's values (EVDWiFi.h, refreshEncoderMirror) so a registration
// or a ctrl push carries the truth. These must match libopus's own values
// because they are sent to the players as-is.
#define OPUS_AUTO                    -1000
#define OPUS_APPLICATION_VOIP        2048
#define OPUS_APPLICATION_AUDIO       2049
#define OPUS_APPLICATION_RESTRICTED_LOWDELAY 2051

// ---- Buffers ---------------------------------------------------------------
// 16 slots = 320 ms of encoded audio in DRAM. The pacer drains at 50 Hz; the
// link produces at 50 Hz. 16 is the burst headroom for an HTTP poll stealing
// core 0 for a few milliseconds.
#define OPUS_QUEUE_LEN 16

// ---- UDP transport ---------------------------------------------------------
#define AUDIO_UDP_PORT      4202
#define CTRL_UDP_PORT       4203
#define CLOCK_SYNC_UDP_PORT 4204
#define DISCOVERY_PORT      4201
#define DISCOVERY_MAGIC_REQ "ENKELVOUDP/1 DISCOVER"
#define DISCOVERY_MAGIC_RPY "ENKELVOUDP/1 SERVER"
// How often an unpaired board broadcasts a probe. 3 s is fast enough that two
// freshly flashed boards pair while you are still looking at the dashboard, and
// slow enough that a lone board does not chatter on a busy LAN.
#define DISCOVERY_TX_MS     3000
// How often a board re-announces itself once paired, so a partner that was
// rebooted with a stale address can find it again.
#define DISCOVERY_ANNOUNCE_MS 60000

#define MAX_UDP_SUBSCRIBERS 16
#define MAX_SEND_FAILURES_BEFORE_SKIP 10
#define NODE_PERF_MAX_ENTRIES 16

// ---- Wire protocol ---------------------------------------------------------
#define AUDIO_PROTO_MAGIC   0xE1D0
#define AUDIO_PROTO_VERSION 2
#define AUDIO_HDR_MAGIC_BYTES       2
#define AUDIO_HDR_VERSION_BYTES     1
#define AUDIO_HDR_FLAGS_BYTES       1
#define AUDIO_HDR_SEQ_BYTES         4
#define AUDIO_HDR_CAPTURED_MS_BYTES 4
#define AUDIO_HEADER_BYTES (AUDIO_HDR_MAGIC_BYTES + AUDIO_HDR_VERSION_BYTES + \
                            AUDIO_HDR_FLAGS_BYTES + AUDIO_HDR_SEQ_BYTES +   \
                            AUDIO_HDR_CAPTURED_MS_BYTES)
static_assert(AUDIO_HEADER_BYTES == 12,
              "AUDIO_HEADER_BYTES must stay in sync with udpSendTask()");

// ---- Logging ---------------------------------------------------------------
#define LOG_BAUD 115200
extern volatile uint8_t gSerialLogLevel;
inline void evdLogPrintf(char level, const char *fmt, ...);
#define LOGI(fmt, ...) do { if (gSerialLogLevel >= 3) evdLogPrintf('I', fmt, ##__VA_ARGS__); } while (0)
#define LOGW(fmt, ...) do { if (gSerialLogLevel >= 2) evdLogPrintf('W', fmt, ##__VA_ARGS__); } while (0)
#define LOGE(fmt, ...) do { if (gSerialLogLevel >= 1) evdLogPrintf('E', fmt, ##__VA_ARGS__); } while (0)

// ---- Misc ------------------------------------------------------------------
static const char *MAIN_ZONE_ID = "main";
static const unsigned long NVM_SAVE_DELAY_MS       = 5000;
static const unsigned long PLAYER_STALE_TIMEOUT_MS = 70000;
#define AUDIO_BUFFER_MIN_MS 20
#define AUDIO_BUFFER_MAX_MS 600

// ---- POD structs -----------------------------------------------------------
// OpusPacket keeps the producer's fields (samples) plus the two this board
// stamps itself (seq, captured_ms).
struct OpusPacket {
  uint8_t  data[MAX_OPUS_PACKET_LEN];
  int      len;
  uint16_t samples;
  uint32_t captured_ms;
  uint32_t seq;
};

struct Subscriber {
  String   ip;
  String   name;
  unsigned long lastSeenMs = 0;
  uint8_t  consecutiveSendFailures = 0;
  int      declaredAudioProtocolVersion   = -1;
  int      negotiatedAudioProtocolVersion = 0;
  bool     audioCompatible                = false;
  bool     hasCompletedClockSync          = false;
  bool     provisional                    = false;
};

struct PlayerNode {
  String name;
  String ip;
  String version;
  unsigned long lastSeenMs = 0;
  int    declaredAudioProtocolVersion   = -1;
  int    negotiatedAudioProtocolVersion = 0;
  bool   audioCompatible                = false;
  String audioCompatReason              = "no_protocol_declared";
};

struct Zone {
  String id;
  String name;
  int volume = 100;
  bool muted = false;
  std::vector<String> nodeIps;
};

struct NodePerf {
  String ip;
  uint32_t latencyMs = 0;
  uint32_t queueDepth = 0;
  uint32_t target = 0;
  uint16_t rebuffers = 0;
  unsigned long updatedMs = 0;
  bool hasData = false;
};

